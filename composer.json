{
  "name": "zwuiix-cmd/store",
  "description": "Format-independent PocketMine-MP 5 configuration and persistence virion.",
  "license": "Apache-2.0",
  "autoload": {
    "classmap": ["src"]
  },
  "autoload-dev": {
    "psr-4": {
      "zwuiix\\store\\tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Zwuiix",
      "email": "71025924+Zwuiix-cmd@users.noreply.github.com"
    }
  ],
  "require": {
    "php": "~8.4.0"
  },
  "suggest": {
    "ext-yaml": "Enable YAML codec support."
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.86",
    "axolotl-pm/pocketmine-mp": "dev-stable",
    "phpunit/phpunit": "^11.5"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/axolotl-pm/PocketMine-MP",
      "no-api": true
    }
  ],
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "make": [
      "@composer install --classmap-authoritative --ignore-platform-reqs",
      "@php -dphar.readonly=0 build/compiler.php"
    ],
    "cs-fixer": [
      "@composer install --classmap-authoritative --ignore-platform-reqs",
      "./vendor/bin/php-cs-fixer fix -v"
    ],
    "store": "@php build/store.php"
  }
}
